# Resend (solo servidor, nunca usar el prefijo NEXT_PUBLIC_)
# Copia este archivo a .env.local y completa los valores.
RESEND_API_KEY=

# Remitente. En desarrollo: Arcade Vault <onboarding@resend.dev>
# En producción: un dominio verificado en Resend.
CONTACT_FROM=

# Correo que recibe los mensajes.
# Con onboarding@resend.dev Resend solo entrega al correo dueño de la cuenta.
CONTACT_TO=


SUPABASE_DB_PASSWORD=

# Supabase. La clave publishable es pública por diseño; la seguridad la dan las políticas RLS.
# URL y clave: Project Settings > API (o MCP: get_project_url / get_publishable_keys).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
